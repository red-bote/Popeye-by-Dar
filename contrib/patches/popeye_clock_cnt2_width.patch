# popeye.vhd: widen clock_cnt2 from 4 to 5 bits; the 4-bit counter never reached the
# "10011" (19) reload and wrapped mod 16, so the CPU ran at f/8 and the AY at f/16
# (about 25% fast).
--- a/vhdl_popeye_rev_0_3_2020_01_27/rtl_dar/popeye.vhd
+++ b/vhdl_popeye_rev_0_3_2020_01_27/rtl_dar/popeye.vhd
@@ -376,7 +376,7 @@
   signal clock_vid : std_logic;
   signal clock_vidn: std_logic;
   signal clock_cnt1: std_logic_vector(3 downto 0) := "0000";
-  signal clock_cnt2: std_logic_vector(3 downto 0) := "0000";
+  signal clock_cnt2: std_logic_vector(4 downto 0) := "00000"; -- 5 bits for the "10011" (19) reload (4 bits ran the CPU at f/8, the AY at f/16)
 
   signal hcnt    : std_logic_vector(9 downto 0) := (others=>'0'); -- horizontal counter
   signal hflip   : std_logic_vector(9 downto 0) := (others=>'0'); -- horizontal counter flip
